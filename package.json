{
	"name": "dmarc-wiki",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check-updates": "npx npm-check-updates -i --format group,repo --cooldown 1d",
		"check-updates-semver": "npx npm-check-updates -i --format group,repo --cooldown 1d --target semver"
	},
	"devDependencies": {
		"@kasisoft/remark-svelte-auto-import": "^0.2.10",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.13.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-rewrite": "^4.0.4",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.2",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-meta-tags": "^5.0.1",
		"svelte-sitemap": "^4.0.4",
		"svooltip": "^0.9.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^7.3.6"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/zilla-slab": "^5.2.8",
		"@lucide/svelte": "^1.22.0",
		"mode-watcher": "^1.1.0"
	}
}
